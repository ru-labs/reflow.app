# Copy to server/.env (gitignored). Never commit real credentials.

# Through the SSH tunnel: ssh -N -L 15432:localhost:5432 reflow-vm
DATABASE_URL=postgres://reflow:CHANGE_ME@localhost:15432/reflow_dev
# Tests DROP and recreate the public schema: the database name must end in _test.
TEST_DATABASE_URL=postgres://reflow:CHANGE_ME@localhost:15432/reflow_test

PORT=3000
# true in production (HTTPS); false for local http
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
# Signup/signin attempts per IP per minute. 0 disables (used by the load test).
AUTH_RATE_LIMIT_PER_MIN=10
RUN_MIGRATIONS=true
