VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Postgres schema to use (default "public"). QUALITY/preprod shares a
# Supabase project with DEV and uses a separate "preprod" schema to stay isolated.
VITE_SUPABASE_SCHEMA=

# Optional: set to "true" to bypass Supabase auth with a mock session and
# seed tasks, for local browser automation / UI review without a real login.
VITE_DEV_MODE=

# Optional: data backend, chosen at build time. "supabase" (default) or "selfhosted"
# (talks to /api on its own origin, no Supabase vars needed). Prefer `npm run build:selfhosted`.
VITE_BACKEND=
