POSTGRES_PASSWORD=
BUILD_MODE=
# VITE_SUPABASE_* is only needed while BUILD_MODE is not "selfhosted"
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_SCHEMA=
VITE_APP_VERSION=
SESSION_TTL_DAYS=30
AUTH_RATE_LIMIT_PER_MIN=10
APP_VERSION=
# Per environment (defaults = the test stack)
PGDATA_VOLUME=reflow_pgdata
DB_HOST_PORT=5432
# Optional Postgres tuning and memory limits (defaults in compose.yaml)
# PG_SHARED_BUFFERS=256MB
# PG_EFFECTIVE_CACHE_SIZE=768MB
# PG_WORK_MEM=4MB
# PG_MAINTENANCE_WORK_MEM=64MB
# PG_MAX_CONNECTIONS=100
# DB_MEM_LIMIT=512m
# API_MEM_LIMIT=384m
# WEB_MEM_LIMIT=64m
